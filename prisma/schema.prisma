generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  OPERADOR
}

enum CertificateStatus {
  ISSUED
  REVOKED
}

enum GeneratedFileType {
  PDF
  DOCX
  PPTX
}

enum CertificateBatchStatus {
  RUNNING
  COMPLETED
  FAILED
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(OPERADOR)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  templates CertificateTemplate[]
  issues    CertificateIssue[]
  batches   CertificateBatch[]
}

model CertificateTemplate {
  id          String   @id @default(cuid())
  name        String
  description String?
  width       Int      @default(1123)
  height      Int      @default(794)
  orientation String   @default("landscape")
  background  String?
  layout      Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  createdById String
  createdBy   User @relation(fields: [createdById], references: [id])

  variables TemplateVariable[]
  issues    CertificateIssue[]
  batches   CertificateBatch[]

  @@index([name])
}

model TemplateVariable {
  id          String   @id @default(cuid())
  key         String
  label       String
  required    Boolean  @default(true)
  createdAt   DateTime @default(now())

  templateId String
  template   CertificateTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([templateId, key])
}

model CertificateRecipient {
  id        String   @id @default(cuid())
  name      String
  email     String?
  document  String?
  createdAt DateTime @default(now())

  issues CertificateIssue[]

  @@index([name])
  @@index([email])
  @@index([document])
}

model CertificateIssue {
  id               String            @id @default(cuid())
  verificationCode String            @unique
  status           CertificateStatus @default(ISSUED)
  values           Json
  issuedAt         DateTime          @default(now())
  revokedAt        DateTime?
  revokeReason     String?
  deleteAt         DateTime?
  hiddenAt         DateTime?
  isTest           Boolean           @default(false)

  templateId String
  template   CertificateTemplate @relation(fields: [templateId], references: [id])

  recipientId String
  recipient   CertificateRecipient @relation(fields: [recipientId], references: [id])

  issuedById String
  issuedBy   User @relation(fields: [issuedById], references: [id])

  batchId String?
  batch   CertificateBatch? @relation(fields: [batchId], references: [id])

  files GeneratedFile[]

  @@index([issuedAt])
  @@index([status, issuedAt])
  @@index([templateId, issuedAt])
  @@index([recipientId, issuedAt])
  @@index([issuedById, issuedAt])
  @@index([batchId, issuedAt])
  @@index([deleteAt])
  @@index([hiddenAt])
}

model CertificateSequence {
  id        String   @id
  value     Int      @default(0)
  updatedAt DateTime @updatedAt
}

model RateLimitAttempt {
  id        String   @id @default(cuid())
  action    String
  keyHash   String
  count     Int      @default(0)
  resetAt   DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([action, keyHash])
  @@index([resetAt])
}

model CertificateBatch {
  id          String                 @id @default(cuid())
  status      CertificateBatchStatus @default(RUNNING)
  total       Int
  processed   Int                    @default(0)
  created     Int                    @default(0)
  errors      Json                   @default("[]")
  values      Json
  company     String
  issuedDate  String
  isTest      Boolean                @default(false)
  startedAt   DateTime               @default(now())
  finishedAt  DateTime?
  lockedAt    DateTime?
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt

  templateId String
  template   CertificateTemplate @relation(fields: [templateId], references: [id])

  createdById String
  createdBy   User @relation(fields: [createdById], references: [id])

  issues CertificateIssue[]
}

model GeneratedFile {
  id        String            @id @default(cuid())
  type      GeneratedFileType
  filename  String
  mimeType  String
  content   Bytes?
  storagePath String?
  createdAt DateTime          @default(now())

  issueId String
  issue   CertificateIssue @relation(fields: [issueId], references: [id], onDelete: Cascade)

  @@unique([issueId, type])
}
